DATABASE_URL=postgresql://stream_user:stream_pass@localhost:5432/stream_db
# JWT 서명 키 — 아래는 **로컬 전용** 값입니다. 배포 서버에서는 반드시 새로 만들어
# 넣으세요. 리포에 적힌 값을 그대로 쓰면 누구나 토큰을 위조할 수 있습니다.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# 비워두면 안 됩니다 — 빈 값은 os.getenv 기본값을 타지 않고 그대로 들어가
# 'HMAC key must not be empty'로 로그인이 실패합니다.
SECRET_KEY=local-dev-only-replace-this-on-deploy
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=

# 프로덕션 AI(검토·챗봇)가 쓰는 Gemini 모델. 비워두면 코드 기본값(gemini-3.7-flash,
# #177)을 쓴다 — 되돌리거나 다른 세대를 시험할 때만 채운다.
# REVIEW_MODEL=gemini-3.7-flash
# CHAT_MODEL=gemini-3.7-flash

# --- #114 LLM 모델 실험 (gpt/gemini/claude/온프레미스 비교, eval_review.py --provider) ---
# 아래 3사 키는 발급 완료(2026-08-27). 비어 있으면 해당 provider만 스킵된다.
# GEMINI_MODEL은 eval 전용 오버라이드다 — 비워두면 프로덕션이 쓰는 모델을 그대로
# 잰다. 여기에 무엇을 적어도 프로덕션 검토·챗봇 모델은 바뀌지 않는다.
# GEMINI_MODEL=gemini-3.7-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# 온프레미스(Ollama, OpenAI 호환 엔드포인트) — 키 불필요, 로컬에 모델만 pull 되어 있으면 됨
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b